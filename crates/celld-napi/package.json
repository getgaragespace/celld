{
  "name": "@celld/napi",
  "version": "0.3.0",
  "private": true,
  "description": "A celld node inside a Bun or Node process, with its storage in node:vfs",
  "license": "Apache-2.0",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "build": "cargo build --release -p celld-napi && cp ../../target/release/libcelld_napi.so celld.node",
    "build:debug": "cargo build -p celld-napi && cp ../../target/debug/libcelld_napi.so celld.node",
    "test": "bun test --timeout 120000",
    "test:node": "node --experimental-vfs test/node-smoke.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
